# Windows download artifacts
*Zone.Identifier

# Antigravity CLI tool data (not part of repo)
.antigravitycli/

# OS files
.DS_Store
Thumbs.db
notebooklm_cookies.txt

# Obsidian
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/
.obsidian/themes/

# KB graph backend (graphify outputs)
# Committed: graph.json, communities.json, GRAPH_REPORT.md, manifest.json, surprising.json
# Gitignored: the viz HTML (regenerable, ~4MB), the SHA256 extraction cache,
# and the raw pre-consolidation chunks (7MB, preserved for compute-surprising regeneration)
kb/.kb/graph/graph.html
kb/.kb/graph/cache/
kb/.kb/graph/raw_chunks/

# Leo Google integration (credentials/tokens live in ~/.config/leo/, but defense in depth)
google_credentials.json
google_token.json
drive_folders.json

# Python bytecode
__pycache__/
*.pyc

# doc-viewer rendered HTML (regenerable via scripts/doc_viewer.py)
system/doc_viewer/

# Google Drive "Leo Inbox" symlink — files dropped here sync via Drive for Desktop,
# not via git. See feedback_inbox_no_read memory.
inbox

# Large downloaded reference PDFs (re-downloadable, image-heavy). The aman.ai primers
# are kept as converted searchable markdown at
# interview_prep/technical_foundations/references/aman/*.md instead of the ~227MB PDFs.
self/interview_prep/aman_*.pdf
self/interview_prep/llm_eval/*.pdf
